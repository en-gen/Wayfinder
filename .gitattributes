# Any committed shell script needs a real "#!/usr/bin/env bash" shebang line ending to run where
# it is actually executed (a Linux CI box, WSL, a contributor's Linux dev machine) - CRLF line
# endings on a shebang line make the interpreter path unresolvable ("bad interpreter"). Force LF
# regardless of the checkout OS's core.autocrlf setting. (The rule outlived its original subject:
# devops/eval/eval-authenticated.sh was removed with the HTTP ingress under D-2026-09-13.)
*.sh text eol=lf

# Husky.NET pre-commit hook is a #!/bin/sh script with no file extension - same
# "bad interpreter" risk as the .sh files above, so force LF on checkout too.
.husky/pre-commit text eol=lf
