<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The HTTP ingress: controllers, model binding, ProblemDetails, IActionResult - all live in
         the shared ASP.NET Core runtime, not a NuGet package. FrameworkReference (not
         PackageReference) is the correct way for a class library to depend on it - Wayfinder.Silo (a
         Sdk.Web project) already carries the framework at the host level; this makes Wayfinder.Api
         buildable/testable as its own class library too, same reasoning as Wayfinder.Grains referencing
         Microsoft.Orleans.Sdk directly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADO #32/#33 - OData query support ($select/$expand) on the case-read surface. Pinned to the
         latest STABLE 9.x release: Microsoft.AspNetCore.OData's own net10-targeted line (10.0.x) is
         still preview-only as of this writing (10.0.0-preview.2) - see AddWayfinderApi's remarks for the
         full reasoning. 9.4.1 targets net8.0 per its own dependency group, but ASP.NET Core's public
         surface (IActionFilter, ODataOptions, [EnableQuery], etc.) that this package binds against
         has been stable/additive since net8, so it loads and runs correctly on net10 - the same
         "run an n-2 stable library on the latest runtime" pattern already used elsewhere in this
         solution. MIT licensed (Microsoft/.NET Foundation). -->
    <PackageReference Include="Microsoft.AspNetCore.OData" Version="9.4.1" />
    <!-- ADO #32/#33 - URL-segment API versioning (api/v1/..., additive toward a future v2).
         Asp.Versioning.OData (the OData-aware versioning package) has NO stable net10 release yet
         (only 10.0.0-rc.1, pulling in Microsoft.AspNetCore.OData 10.0.0-preview.2) - disqualified by
         the stable-only constraint. Plain Asp.Versioning.Mvc/.ApiExplorer DO have a stable net10
         10.0.0 release (verified via nuspec: targetFramework net10.0, MIT licensed), so versioning
         is composed by hand instead: AddApiVersioning + AddRouteComponents (see
         DependencyInjection/ServiceCollectionExtensions.cs). -->
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <!-- ADO #32 - net10's built-in Microsoft-owned OpenAPI document generator (Microsoft.
         AspNetCore.OpenApi, not Swashbuckle) - MIT licensed, versioned in lockstep with the
         TargetFramework's runtime line. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Microsoft.AspNetCore.OpenApi 10.0.9 pins a floor of Microsoft.OpenApi 2.0.0, which carries
         a known high-severity advisory (GHSA-v5pm-xwqc-g5wc, stack-overflow-via-circular-schema on
         parse) that trips this solution's NuGetAudit gate (Directory.Build.props). Pinned up to the
         2.X line's patched release (2.7.5+) explicitly - a same-major bump over the transitive
         floor, not a cross-major jump, to stay within Microsoft.AspNetCore.OpenApi 10.0.9's tested
         API surface. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.6" />
    <!-- ADO #33 - JwtBearer authentication against the trusted Zitadel issuer (Authority/Audience
         from configuration - see Infrastructure/Options/ZitadelAuthOptions.cs). Still shipped as a
         NuGet package (not part of the Microsoft.AspNetCore.App shared framework) even on net10;
         MIT licensed. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wayfinder.Application\Wayfinder.Application.csproj" />
    <ProjectReference Include="..\Wayfinder.Contracts\Wayfinder.Contracts.csproj" />
    <!-- Named explicitly (not left to transitivity through Wayfinder.Application) - the identity
         middleware and the CrossTenantAccessException->404 mapper both speak
         Wayfinder.Grains.Interfaces types directly (CaseRequestContext, CrossTenantAccessException),
         same as Wayfinder.Application does. -->
    <ProjectReference Include="..\Wayfinder.Grains.Interfaces\Wayfinder.Grains.Interfaces.csproj" />
  </ItemGroup>

</Project>
