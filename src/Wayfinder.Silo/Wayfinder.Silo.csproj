<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting comes transitively via Microsoft.Orleans.Server / the Web SDK -->
    <!-- BlobServiceClient registered from the Azure:Storage config SECTION (AddAzureClients):
         the section's shape picks the auth mode - connectionString locally/Azurite, serviceUri +
         credential when deployed. Azure.Identity supplies the DefaultAzureCredential wired as the
         global fallback TokenCredential (UseCredential) so the deployed flip is config-only.
         See Program.cs ConfigureServices and AzureOptions. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.14.0" />
    <PackageReference Include="Microsoft.Orleans.EventSourcing" Version="10.2.1" />
    <!-- Journaled-grain (LogStorage log-consistency) storage backend: Azure Blob, Azurite in
         Development (work item #54). See Program.cs ConfigureDevelopmentOrleans for the slot
         this is wired into and why. -->
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Reminders" Version="10.2.2" />
    <!-- Durable reminder storage for the deployed path (work item #30): Azure Table, same
         cluster-membership table endpoint as Clustering.AzureStorage below. Development keeps
         UseInMemoryReminderService(); see Program.cs ConfigureDeployedOrleans. -->
    <PackageReference Include="Microsoft.Orleans.Reminders.AzureStorage" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.2.1" />
    <!--
      Re-added for the deployed-cluster path (work item #30): real Orleans clustering via Azure
      Table membership, validated against Azurite's table endpoint (ConfigureDeployedOrleans).
      Microsoft.Orleans.Hosting.AzureCloudServices and Microsoft.Orleans.OrleansAzureUtils remain
      removed - no code path references those.
    -->
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" Version="10.2.1" />
    <PackageReference Include="Quartz" Version="3.18.2" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADO #32/#33 - the HTTP ingress (OData + versioning + JwtBearer auth + the identity
         middleware). Wired in via AddWayfinderApi()/MapWayfinderApi() (see Program.cs/Startup.cs) - Wayfinder.Silo
         stays the composition root, Wayfinder.Api stays a plug-in with no knowledge of Orleans hosting. -->
    <ProjectReference Include="..\Wayfinder.Api\Wayfinder.Api.csproj" />
    <ProjectReference Include="..\Wayfinder.Grains.Interfaces\Wayfinder.Grains.Interfaces.csproj" />
    <ProjectReference Include="..\Wayfinder.Grains\Wayfinder.Grains.csproj" />
  </ItemGroup>

</Project>
