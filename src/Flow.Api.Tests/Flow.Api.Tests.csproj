<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADO #32/#33 - unit-level ONLY (per that work item's test plan): fakes ISender/
         ITenantResolver rather than spinning a full host/TestServer, so this project needs the
         FrameworkReference for MVC/HTTP abstraction types (HttpContext, IActionResult,
         ObjectResult, ...) but no Microsoft.AspNetCore.Mvc.Testing/TestServer package at all. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- pinned: last version before v8's Xceed commercial license -->
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flow.Api\Flow.Api.csproj" />
    <ProjectReference Include="..\Flow.Application\Flow.Application.csproj" />
    <ProjectReference Include="..\Flow.Contracts\Flow.Contracts.csproj" />
    <ProjectReference Include="..\Flow.Grains.Interfaces\Flow.Grains.Interfaces.csproj" />
  </ItemGroup>

</Project>
