<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADO #21 conformance scenario - 8.3 Table 8.2 CaseFileItem operation: addChild.
  ~~~~~
  Table 8.2: "addChild (Available -> Available)" is one of the eight CaseFileItem operations - a
  Sentry keyed to it must fire on ICaseFileItemGrain.AddChild(...). This exercises the OPERATION
  (a runtime transition trigger) only, not the static caseFileItem/children hierarchy the capability
  lint flags as structurally-unsupported (CmmnCapabilityLint rule 5) - ParentItem/ChildItem below
  are declared as two independent, non-nested caseFileItem elements.
-->
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
             targetNamespace="http://case.flow/conformance/casefile-addchild-drives-onpart"
             expressionLanguage="expression://lang/jint"
             id="Definitions_CaseFileAddChildDrivesOnPart"
             name="CaseFileAddChildDrivesOnPartSample"
             exporter="Case.Flow conformance suite"
             exporterVersion="1.0">
  <caseFileItemDefinition id="CFID_1" name="ItemDef" definitionType="http://www.omg.org/spec/CMMN/DefinitionType/Unspecified"/>
  <case id="CaseFileAddChildDrivesOnPartCase" name="CaseFileAddChildDrivesOnPartCase">
    <caseFileModel>
      <caseFileItem id="ParentItem" name="ParentItem" definitionRef="CFID_1" multiplicity="ExactlyOne"/>
      <caseFileItem id="ChildItem" name="ChildItem" definitionRef="CFID_1" multiplicity="ExactlyOne"/>
    </caseFileModel>
    <casePlanModel id="CPM" name="CasePlanModel" autoComplete="true">
      <planItem id="PlanItemA" name="PlanItemA" definitionRef="MilestoneA">
        <entryCriterion id="EntryCriterion_1" sentryRef="EntrySentry"/>
      </planItem>
      <sentry id="EntrySentry" name="EntrySentry">
        <caseFileItemOnPart id="OnPart_1" sourceRef="ParentItem">
          <standardEvent>addChild</standardEvent>
        </caseFileItemOnPart>
      </sentry>
      <milestone id="MilestoneA" name="MilestoneA"/>
    </casePlanModel>
    <caseRoles/>
  </case>
</definitions>
