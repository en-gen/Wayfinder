<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting comes transitively via Microsoft.Orleans.Server / the Web SDK -->
    <PackageReference Include="Microsoft.Orleans.EventSourcing" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Reminders" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.2.1" />
    <!--
      Microsoft.Orleans.Clustering.AzureStorage, Microsoft.Orleans.Hosting.AzureCloudServices, and
      Microsoft.Orleans.OrleansAzureUtils removed: no code path that runs today references them
      (ConfigureDeployedOrleans below is a NotImplementedException stub). Re-add
      Microsoft.Orleans.Clustering.AzureStorage (its modern equivalent) when the deployed-cluster
      path (M2) is implemented for real.
    -->
    <PackageReference Include="Quartz" Version="3.18.2" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flow.Grains.Interfaces\Flow.Grains.Interfaces.csproj" />
    <ProjectReference Include="..\Flow.Grains\Flow.Grains.csproj" />
  </ItemGroup>

</Project>
