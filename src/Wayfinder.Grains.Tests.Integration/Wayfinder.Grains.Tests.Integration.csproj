<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoFixture.Xunit2" Version="4.18.1" />
    <!-- Azurite restart-survival suite (work item #54): AzuriteClusterFixture mirrors Wayfinder.Silo's
         AddAzureClients config-section registration path exactly (Microsoft.Extensions.Azure +
         Azure.Identity for the UseCredential fallback); Azure.Storage.Blobs also backs the
         belt-and-braces assertion that the journal actually lands in blob storage, not a silent
         fallback to memory. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <!-- Testcontainers-provisioned Azurite (work item #60, replacing the manual/compose-managed
         probe from #54/#17): MIT-licensed, maintained by the Testcontainers org, actively
         released (4.13.0, 2026-07). AzuriteClusterFixture owns the container lifecycle; see
         that file for the AzuriteBuilder/AzuriteContainer wiring. -->
    <PackageReference Include="Testcontainers.Azurite" Version="4.15.0" />
    <!-- Docker-availability gate (DockerAvailability/RequiresDockerFact): the same client
         library Testcontainers itself uses to talk to the daemon (pinned to the exact version
         Testcontainers.Azurite 4.13.0 pulls transitively), so the discovery-time probe and the
         real container start resolve the Docker endpoint identically and can never disagree. -->
    <PackageReference Include="Docker.DotNet.Enhanced" Version="4.3.3" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.14.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- pinned: last version before v8's Xceed commercial license -->
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Azurite restart-survival suite (work item #54): journaled-grain storage backend under test. -->
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.2.1" />
    <!-- Real Azure Table clustering suite (work item #30): validates Wayfinder.Silo's
         ConfigureDeployedOrleans clustering choice (UseAzureStorageClustering) actually forms a
         multi-silo cluster against a real Azure Table membership store (Azurite locally/in CI). -->
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.2.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- ADO #32 - the CQRS core under test: the Application/ suite dispatches the case commands/
         queries through the real ISender (AddWayfinderApplication) over the in-memory ClusterFixture,
         asserting the Wayfinder.Contracts.V1 projections come back correct. -->
    <ProjectReference Include="..\Wayfinder.Application\Wayfinder.Application.csproj" />
    <ProjectReference Include="..\Wayfinder.Contracts\Wayfinder.Contracts.csproj" />
    <ProjectReference Include="..\Wayfinder.Grains.Interfaces\Wayfinder.Grains.Interfaces.csproj" />
    <ProjectReference Include="..\Wayfinder.Grains.Tests.Utils\Wayfinder.Grains.Tests.Utils.csproj" />
    <ProjectReference Include="..\Wayfinder.Grains\Wayfinder.Grains.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADO #20 - the flagship .cmmn file; embedded so the test never depends on the test
         assembly's output directory layout. -->
    <EmbeddedResource Include="Interchange\Samples\*.cmmn" />
    <!-- ADO #21 - the conformance suite's scenario corpus: every scenario is a real .cmmn file,
         embedded for the same reason as the #20 flagship above. -->
    <EmbeddedResource Include="Conformance\Samples\*.cmmn" />
    <!-- Issue #247 (P0 characterization) - the committed final-state baselines the conformance
         scenarios verify against (see Conformance/CaseCharacterization.cs). Embedded for the
         same reason as the samples above: the comparison must not depend on the test assembly's
         output directory layout. -->
    <EmbeddedResource Include="Conformance\Baselines\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #153/#154: the real root cause of the suite's CI flakiness was 2-vCPU
         oversubscription - 4 xUnit collections (4 TestClusters, 2 silos each) with xUnit's
         default of running 2 collections concurrently meant up to 4 silos plus the Azurite
         container fighting over 2 cores. parallelizeTestCollections: false keeps only one
         TestCluster live at a time so each silo actually gets both cores. Must be copied next to
         the test assembly (xunit picks up xunit.runner.json from the assembly's own directory) -
         verified present in bin/Release/net10.0 after build. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
