<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADO #21 conformance scenario - 8.6.2 ManualActivationRule / Table 8.8.
  ~~~~~
  8.6.2: "If this rule evaluates to TRUE, the Task or Stage instance transitions from Available to
  Enabled, otherwise it transitions from Available to Active." TaskA's ManualActivationRule
  explicitly evaluates FALSE, so it must skip Enabled entirely and auto-start straight to Active.
-->
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
             targetNamespace="http://wayfinder/conformance/lifecycle-manual-activation-false"
             expressionLanguage="expression://lang/jint"
             id="Definitions_LifecycleManualActivationFalse"
             name="LifecycleManualActivationFalseSample"
             exporter="Wayfinder conformance suite"
             exporterVersion="1.0">
  <case id="LifecycleManualActivationFalseCase" name="LifecycleManualActivationFalseCase">
    <casePlanModel id="CPM" name="CasePlanModel" autoComplete="true">
      <planItem id="PlanItemA" name="PlanItemA" definitionRef="TaskA"/>
      <humanTask id="TaskA" name="TaskA" isBlocking="true">
        <defaultControl id="Control_1">
          <manualActivationRule id="MAR_1">
            <condition language="expression://lang/jint">false</condition>
          </manualActivationRule>
        </defaultControl>
      </humanTask>
    </casePlanModel>
    <caseRoles/>
  </case>
</definitions>
