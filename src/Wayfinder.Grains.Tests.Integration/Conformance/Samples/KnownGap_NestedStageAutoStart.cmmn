<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADO #21 conformance scenario - Table 8.8 start (Stage) + 8.7 instantiation. Originally
  authored as a KNOWN GAP (discovered by this suite); fixed by #64 - see below.
  ~~~~~
  Table 8.8 (start): with a FALSE ManualActivationRule a Stage moves Available -> Active with no
  Case-worker involvement, and 8.7 requires its planned PlanItems to instantiate on that entry to
  Active. StageA below is exactly that shape. Its activation used to crash the engine (FINDING-2):
  the auto-start path (EnableOrStart firing Start while the Create trigger is still being
  processed) reached StageBehavior.HandleEnterActiveFromStart on a non-activation thread, and the
  first Host.GrainFactory access threw "Activation access violation" - fixed by #64
  (PlanItemStateMachine.RetainSynchronizationContext = true). The same model with a default-TRUE
  ManualActivationRule (Enabled + an explicit ManualStart grain call) instantiates its children
  fine - see Lifecycle_NestedStageManualStart.cmmn. TaskA's definition is hoisted to the
  casePlanModel level, so definition resolution (the separate
  KnownGap_NestedDefinitionDeclaration gap) plays no part in this scenario. See
  KnownGapScenarios.cs for the observed stack and evidence.
-->
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
             targetNamespace="http://wayfinder/conformance/knowngap-nested-stage-auto-start"
             expressionLanguage="expression://lang/jint"
             id="Definitions_KnownGapNestedStageAutoStart"
             name="KnownGapNestedStageAutoStartSample"
             exporter="Wayfinder conformance suite"
             exporterVersion="1.0">
  <case id="KnownGapNestedStageAutoStartCase" name="KnownGapNestedStageAutoStartCase">
    <casePlanModel id="CPM" name="CasePlanModel" autoComplete="false">
      <planItem id="PlanItemStageA" name="PlanItemStageA" definitionRef="StageA"/>
      <stage id="StageA" name="StageA" autoComplete="false">
        <defaultControl id="Control_Stage">
          <manualActivationRule id="MAR_Stage">
            <condition language="expression://lang/jint">false</condition>
          </manualActivationRule>
        </defaultControl>
        <planItem id="PlanItemTaskA" name="PlanItemTaskA" definitionRef="TaskA"/>
      </stage>
      <humanTask id="TaskA" name="TaskA" isBlocking="true">
        <defaultControl id="Control_Task">
          <manualActivationRule id="MAR_Task">
            <condition language="expression://lang/jint">false</condition>
          </manualActivationRule>
        </defaultControl>
      </humanTask>
    </casePlanModel>
    <caseRoles/>
  </case>
</definitions>
