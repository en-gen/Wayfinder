<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin package sources for hermetic builds: everything this solution consumes
       is public, and nuget.org serves the vulnerability data NuGet Audit
       (Directory.Build.props) depends on. <clear /> shields the build from
       machine-level feed configuration. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
